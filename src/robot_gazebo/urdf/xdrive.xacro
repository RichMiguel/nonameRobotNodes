<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="xdrive">

    <!-- ==================== PROPERTIES ==================== -->
    <xacro:property name="PI" value="3.14159265359" />

    <!-- Dimensi sasis -->
    <xacro:property name="base_length" value="0.38" />
    <xacro:property name="base_width" value="0.38" />
    <xacro:property name="base_height" value="0.04" />

    <!-- Dimensi & Posisi roda -->
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_width" value="0.025" />
    <xacro:property name="wheel_offset_x" value="0.20" />
    <xacro:property name="wheel_offset_y" value="0.20" />

    <!-- Massa -->
    <xacro:property name="base_mass" value="2.0" />
    <xacro:property name="wheel_mass" value="0.2" />

    <!-- ==================== MACROS INERTIAL ==================== -->
    <xacro:macro name="box_inertial" params="mass x y z">
        <inertial>
            <mass value="${mass}" />
            <inertia
                ixx="${mass*(y*y + z*z)/12.0}" ixy="0.0" ixz="0.0"
                iyy="${mass*(x*x + z*z)/12.0}" iyz="0.0"
                izz="${mass*(x*x + y*y)/12.0}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertial" params="mass radius length">
        <inertial>
            <mass value="${mass}" />
            <inertia
                ixx="${mass*(3*radius*radius + length*length)/12.0}" ixy="0.0" ixz="0.0"
                iyy="${mass*(3*radius*radius + length*length)/12.0}" iyz="0.0"
                izz="${mass*radius*radius/2.0}" />
        </inertial>
    </xacro:macro>

    <!-- ==================== MACRO RODA X-DRIVE ==================== -->
    <xacro:macro name="xdrive_wheel" params="name x_reflect y_reflect yaw_angle">
        <!-- LINK RODA -->
        <link name="${name}_wheel">
            <visual>
                <!-- Geometri roda murni berada di origin lokal (0 0 0) -->
                <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
                <material name="dark_gray">
                    <color rgba="0.2 0.2 0.2 1.0" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
            </collision>
            <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}"
                length="${wheel_width}" />
        </link>

        <!-- Sifat Gesekan Omni-wheel: Grip di arah rolling (mu1=1.0), Bebas geser di arah roller/aksial (mu2=0.0) -->
        <gazebo reference="${name}_wheel">
            <mu1>1.0</mu1>
            <mu2>0.0</mu2>
            <fdir1>1 0 0</fdir1>
        </gazebo>

        <!-- JOINT RODA (Menghubungkan ke base_link) -->
        <joint name="${name}_wheel_joint" type="continuous">
            <parent link="base_link" />
            <child link="${name}_wheel" />
            <!-- Posisi x, y, z dan rotasi sudut X-Drive dialokasikan di joint -->
            <origin
                xyz="${x_reflect * wheel_offset_x} ${y_reflect * wheel_offset_y} 0.0"
                rpy="0 0 ${yaw_angle}" />
            <!-- Sumbu putar roda (lokal Y relatif terhadap orientasi roda) -->
            <axis xyz="0 1 0" />
        </joint>
    </xacro:macro>

    <!-- ==================== BASE LINKS ==================== -->
    <link name="base_footprint" />

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
        </collision>
        <xacro:box_inertial mass="${base_mass}" x="${base_length}" y="${base_width}"
            z="${base_height}" />
    </link>

    <link name="mid_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.38 0.38 0.5" />
            </geometry>
            <material name="gray">
                <color rgba="0.25 0.25 0.25 1.0" />
            </material>
        </visual>
    </link>

    <joint name="mid_joint" type="fixed">
        <parent link="base_link" />
        <child link="mid_link" />
        <origin xyz="0 0 0.27" rpy="0 0 0" />
    </joint>

    <!-- ==================== PEMANGGILAN 4 RODA X-DRIVE ==================== -->
    <!-- Front Left (135 Derajat) -->
    <xacro:xdrive_wheel name="front_left" x_reflect="1" y_reflect="1" yaw_angle="${135*PI/180}" />

    <!-- Front Right (45 Derajat) -->
    <xacro:xdrive_wheel name="front_right" x_reflect="1" y_reflect="-1" yaw_angle="${45*PI/180}" />

    <!-- Rear Left (-135 Derajat) -->
    <xacro:xdrive_wheel name="rear_left" x_reflect="-1" y_reflect="1" yaw_angle="${-135*PI/180}" />

    <!-- Rear Right (-45 Derajat) -->
    <xacro:xdrive_wheel name="rear_right" x_reflect="-1" y_reflect="-1" yaw_angle="${-45*PI/180}" />

    <!-- ==================== SENSOR LIDAR ==================== -->
    <link name="laser">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.035" length="0.04" />
            </geometry>
            <material name="red">
                <color rgba="0.8 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.035" length="0.04" />
            </geometry>
        </collision>
        <xacro:cylinder_inertial mass="0.1" radius="0.035" length="0.04" />
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser" />
        <!-- Diletakkan di atas mid_link dengan clearance yang aman (mid_link top = 0.52m) -->
        <origin xyz="0 0 0.58" rpy="0 0 0" />
    </joint>

    <gazebo reference="laser">
        <sensor name="rplidar_sensor" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <!-- Paksa frame_id LaserScan = 'laser'. Tanpa ini Gazebo Harmonic memakai
                 nama otomatis 'xdrive/base_footprint/rplidar_sensor' (karena link laser
                 di-lump ke base_footprint saat konversi URDF->SDF) yang tidak ada di TF. -->
            <frame_id>laser</frame_id>
            <gz_frame_id>laser</gz_frame_id>
            <update_rate>10.0</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <!-- Batas min 0.28m mencegah ray mengenai sudut sasis/mid_link robot (radius sasis ~0.27m) -->
                    <min>0.28</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <always_on>true</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

    <!-- ==================== GAZEBO HARMONIC SYSTEM PLUGINS ==================== -->
    <gazebo>
        <!-- Kontrol Kecepatan Holonomik (Menerima /cmd_vel: vx, vy, wz) -->
        <plugin
            filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
            <link_name>base_link</link_name>
            <topic>cmd_vel</topic>
        </plugin>

        <!-- Odometri Publisher (Mengeluarkan /odom & TF odom -> base_footprint) -->
        <plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
        </plugin>

        <!-- Joint State Publisher untuk roda -->
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
        </plugin>

        <!-- Joint Controllers untuk memutar 4 Roda X-Drive di Gazebo Harmonic -->
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>front_left_wheel_joint</joint_name>
            <sub_topic>joint/front_left_wheel_joint/cmd_vel</sub_topic>
        </plugin>
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>front_right_wheel_joint</joint_name>
            <sub_topic>joint/front_right_wheel_joint/cmd_vel</sub_topic>
        </plugin>
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>rear_left_wheel_joint</joint_name>
            <sub_topic>joint/rear_left_wheel_joint/cmd_vel</sub_topic>
        </plugin>
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
            <joint_name>rear_right_wheel_joint</joint_name>
            <sub_topic>joint/rear_right_wheel_joint/cmd_vel</sub_topic>
        </plugin>
    </gazebo>
</robot>