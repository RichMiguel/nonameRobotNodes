<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="complex_room">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Main Outer Walls (10x10) -->
    <model name="outer_wall_n">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 2</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>
    <model name="outer_wall_s">
      <static>true</static>
      <pose>0 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 2</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>
    <model name="outer_wall_e">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 10.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 10.2 2</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>
    <model name="outer_wall_w">
      <static>true</static>
      <pose>-5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 10.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 10.2 2</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>

    <!-- Room 1 (Top-Left 4x4) -->
    <!-- South Wall with Doorway -->
    <model name="room1_s1">
      <static>true</static>
      <pose>-3.5 1 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3 0.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3 0.2 2</size></box></geometry><material><ambient>0.7 0.7 0.9 1</ambient></material></visual>
      </link>
    </model>
    <!-- East Wall -->
    <model name="room1_e">
      <static>true</static>
      <pose>-1 3 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4 2</size></box></geometry><material><ambient>0.7 0.7 0.9 1</ambient></material></visual>
      </link>
    </model>

    <!-- Room 2 (Bottom-Right 4x4) -->
    <!-- North Wall with Doorway -->
    <model name="room2_n1">
      <static>true</static>
      <pose>3.5 -1 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3 0.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3 0.2 2</size></box></geometry><material><ambient>0.9 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>
    <!-- West Wall -->
    <model name="room2_w">
      <static>true</static>
      <pose>1 -3 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4 2</size></box></geometry><material><ambient>0.9 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- Obstacles inside Room 1 -->
    <model name="box1">
      <static>true</static>
      <pose>-3 3 0.5 0 0 0.5</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>0.2 0.8 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- Obstacles inside Room 2 -->
    <model name="cyl1">
      <static>true</static>
      <pose>3 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.6</radius><length>1</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.6</radius><length>1</length></cylinder></geometry><material><ambient>0.8 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>
    
    <!-- Obstacle removed to allow robot to spawn here -->

  </world>
</sdf>
